-- Ensure the SCA schema exists
CREATE SCHEMA IF NOT EXISTS "SCA";

-- Drop tables if they already exist to ensure a clean slate for testing
-- (Use with caution in production, but good for development testing)
DROP TABLE IF EXISTS "SCA"."LivraisonConducteurColis" CASCADE;
DROP TABLE IF EXISTS "SCA"."Conducteur" CASCADE;
DROP TABLE IF EXISTS "SCA"."DriverLocations" CASCADE;
DROP TABLE IF EXISTS "SCA"."entrepot" CASCADE;
DROP TABLE IF EXISTS "SCA"."ConsommationVehicule" CASCADE;

-- Re-create the Conducteur table
CREATE TABLE IF NOT EXISTS "SCA"."Conducteur" (
    idconducteur VARCHAR(50) PRIMARY KEY,
    nom VARCHAR(100) NOT NULL,
    prenom VARCHAR(100) NOT NULL,
    telephone VARCHAR(20),
    email VARCHAR(100) UNIQUE
);

-- Re-create LivraisonConducteurColis with new columns
CREATE TABLE IF NOT EXISTS "SCA"."LivraisonConducteurColis" (
    idbonexpedition VARCHAR(50) PRIMARY KEY,
    idconducteur VARCHAR(50) NOT NULL,
    nom_destinataire VARCHAR(255) NOT NULL,
    adresse TEXT NOT NULL,
    date_expedition DATE,
    date_prevue DATE,
    date_livree DATE,
    poids VARCHAR(50),
    volume VARCHAR(50),
    type_colis VARCHAR(100),
    instructions TEXT,
    delivery_latitude NUMERIC,
    delivery_longitude NUMERIC,
    status VARCHAR(50) DEFAULT 'pending',
    date_affectation TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (idconducteur) REFERENCES "SCA"."Conducteur"(idconducteur)
);

-- Create DriverLocations table
CREATE TABLE IF NOT EXISTS "SCA"."DriverLocations" (
    id SERIAL PRIMARY KEY,
    idconducteur VARCHAR(50) UNIQUE NOT NULL,
    current_latitude NUMERIC NOT NULL,
    current_longitude NUMERIC NOT NULL,
    last_updated TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (idconducteur) REFERENCES "SCA"."Conducteur"(idconducteur)
);

-- Tables from your original insert statements
CREATE TABLE IF NOT EXISTS "SCA"."entrepot" (
    idcellule VARCHAR(50) PRIMARY KEY,
    position VARCHAR(255)
);

CREATE TABLE IF NOT EXISTS "SCA"."ConsommationVehicule" (
    idconsommation SERIAL PRIMARY KEY,
    idvehicule VARCHAR(50),
    consommation_moyenne NUMERIC,
    date_mesure DATE,
    conditions_mesure TEXT,
    kilometrage_debut NUMERIC,
    kilometrage_fin NUMERIC,
    litres_consommes NUMERIC,
    type_trajet VARCHAR(100),
    date_creation TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

