# sge_transporteur/kv_files/dashboard_screen.kv

# Définition du widget réutilisable pour les cartes de statistiques
# Ceci correspond à la classe Python DashboardStatCard
<DashboardStatCard@BoxLayout>:
    # L'ID 'root_card' est ajouté ici pour référencer ce widget lui-même
    id: root_card
    orientation: 'vertical'
    size_hint_y: None
    height: dp(120) # Hauteur fixe pour la carte
    padding: app.app_config.PADDING_SMALL
    spacing: app.app_config.SPACING_XS
    card_color: app.app_config.COLOR_BACKGROUND_CARD # Couleur de fond par défaut
    card_border_color: app.app_config.COLOR_PRIMARY # Couleur de bordure par défaut
    title: ''
    value: ''
    icon_source: '' # Chemin vers l'image de l'icône

    canvas.before:
        Color:
            rgba: self.card_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [app.app_config.CORNER_RADIUS_MD] * 4 # Rayon des coins de la carte
        Color: # Pour la bordure supérieure
            rgba: self.card_border_color
        RoundedRectangle:
            pos: self.x, self.y + self.height - dp(5) # Bordure en haut
            size: self.width, dp(5)
            radius: [app.app_config.CORNER_RADIUS_MD, app.app_config.CORNER_RADIUS_MD, 0, 0] # Coins supérieurs arrondis

    Image:
        source: root_card.icon_source # Utilisez root_card.icon_source
        size_hint_y: None
        height: dp(40)
        allow_stretch: True
        keep_ratio: True
        color: root_card.card_border_color # Colore l'icône avec la couleur de la bordure

    Label:
        text: root_card.title
        font_size: app.app_config.FONT_SIZE_SM
        color: app.app_config.COLOR_TEXT_MUTED
        size_hint_y: None
        height: self.texture_size[1]

    Label:
        text: root_card.value
        font_size: app.app_config.FONT_SIZE_LG
        color: app.app_config.COLOR_TEXT_DARK # Couleur du chiffre
        bold: True
        size_hint_y: None
        height: self.texture_size[1]


# Définition de l'écran principal du Dashboard
<DashboardScreen>:
    id: dashboard_screen
    name: 'dashboard'

    BoxLayout:
        orientation: 'horizontal'

        # -----------------------------------------------------
        # 1. Barre Latérale (Sidebar) - Utilise BoxLayout directement
        # -----------------------------------------------------
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.20 # 20% de la largeur de l'écran
            padding: app.app_config.PADDING_MEDIUM
            spacing: app.app_config.SPACING_MEDIUM
            canvas.before:
                Color:
                    rgba: app.app_config.COLOR_SECONDARY # Couleur de fond de la sidebar
                Rectangle:
                    pos: self.pos
                    size: self.size

            # Logo ou titre de l'application
            Image:
                source: 'assets/icon.png' # Assurez-vous que cette image existe
                size_hint_y: None
                height: dp(80)
                allow_stretch: True
                keep_ratio: True
                color: app.app_config.COLOR_PRIMARY # Colore le logo si PNG monochrome

            Label:
                text: "Menu"
                font_size: app.app_config.FONT_SIZE_LG
                color: app.app_config.COLOR_TEXT_LIGHT
                size_hint_y: None
                height: self.texture_size[1] + app.app_config.SPACING_MEDIUM
                halign: 'center'
                valign: 'middle'

            # Boutons de navigation de la Sidebar
            BoxLayout: # Conteneur pour les boutons de navigation
                orientation: 'vertical'
                size_hint_y: 1 # Prend tout l'espace disponible
                spacing: app.app_config.SPACING_SMALL

                Button:
                    text: "Tableau de Bord"
                    font_size: app.app_config.FONT_SIZE_MD
                    background_normal: ''
                    # Utilise COLOR_PRIMARY si actif, sinon COLOR_BUTTON_NORMAL
                    background_color: app.app_config.COLOR_PRIMARY if root.name == 'dashboard' else app.app_config.COLOR_BUTTON_NORMAL
                    color: app.app_config.COLOR_TEXT_LIGHT
                    size_hint_y: None
                    height: dp(50)
                    on_release: root.navigate_to_screen('dashboard')
                    canvas.before:
                        Color:
                            rgba: self.background_color
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [app.app_config.CORNER_RADIUS_SM] * 4

                Button:
                    text: "Livraisons"
                    font_size: app.app_config.FONT_SIZE_MD
                    background_normal: ''
                    background_color: app.app_config.COLOR_PRIMARY if root.name == 'delivery' else app.app_config.COLOR_BUTTON_NORMAL
                    color: app.app_config.COLOR_TEXT_LIGHT
                    size_hint_y: None
                    height: dp(50)
                    on_release: root.navigate_to_screen('delivery')
                    canvas.before:
                        Color:
                            rgba: self.background_color
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [app.app_config.CORNER_RADIUS_SM] * 4

                Button:
                    text: "Conducteurs"
                    font_size: app.app_config.FONT_SIZE_MD
                    background_normal: ''
                    background_color: app.app_config.COLOR_PRIMARY if root.name == 'driver' else app.app_config.COLOR_BUTTON_NORMAL
                    color: app.app_config.COLOR_TEXT_LIGHT
                    size_hint_y: None
                    height: dp(50)
                    on_release: root.navigate_to_screen('driver')
                    canvas.before:
                        Color:
                            rgba: self.background_color
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [app.app_config.CORNER_RADIUS_SM] * 4

                Button:
                    text: "Véhicules"
                    font_size: app.app_config.FONT_SIZE_MD
                    background_normal: ''
                    background_color: app.app_config.COLOR_PRIMARY if root.name == 'vehicle' else app.app_config.COLOR_BUTTON_NORMAL
                    color: app.app_config.COLOR_TEXT_LIGHT
                    size_hint_y: None
                    height: dp(50)
                    on_release: root.navigate_to_screen('vehicle')
                    canvas.before:
                        Color:
                            rgba: self.background_color
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [app.app_config.CORNER_RADIUS_SM] * 4
                
                # Espace flexible pour pousser le bouton de déconnexion vers le bas
                Widget:
                    size_hint_y: 1 # Prend l'espace restant

                Button:
                    text: "Déconnexion"
                    font_size: app.app_config.FONT_SIZE_MD
                    background_normal: ''
                    background_color: app.app_config.COLOR_ERROR # Couleur rouge pour déconnexion
                    color: app.app_config.COLOR_TEXT_LIGHT
                    size_hint_y: None
                    height: dp(50)
                    on_release: root.show_logout_dialog() # Appelle la fonction pour afficher le dialogue
                    canvas.before:
                        Color:
                            rgba: self.background_color
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [app.app_config.CORNER_RADIUS_SM] * 4

        # -----------------------------------------------------
        # 2. Zone de Contenu Principale - Utilise BoxLayout directement comme en-tête
        # -----------------------------------------------------
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.80 # 80% de la largeur de l'écran
            padding: app.app_config.PADDING_LARGE
            spacing: app.app_config.SPACING_MEDIUM
            canvas.before:
                Color:
                    rgba: app.app_config.COLOR_BACKGROUND_DARK # Fond sombre pour le contenu
                Rectangle:
                    pos: self.pos
                    size: self.size

            # En-tête du contenu principal (Titre et message de statut)
            BoxLayout: # Cet BoxLayout agit comme la "TopBar"
                orientation: 'vertical' # Maintenir l'orientation verticale pour le titre et le statut
                size_hint_y: None
                height: dp(80) # Hauteur fixe pour l'en-tête du contenu
                padding: app.app_config.PADDING_SMALL
                spacing: app.app_config.SPACING_XS

                Label:
                    text: "Aperçu du Tableau de Bord"
                    font_size: app.app_config.FONT_SIZE_XL
                    color: app.app_config.COLOR_TEXT_LIGHT
                    size_hint_y: None
                    height: self.texture_size[1]
                    halign: 'left'
                    text_size: self.width, None

                Label:
                    id: dashboard_status_label # ID pour le Label de statut
                    text: root.dashboard_status_message # Message de statut lié à la propriété
                    font_size: app.app_config.FONT_SIZE_SM
                    color: root.dashboard_status_color # Couleur du message liée à la propriété
                    size_hint_y: None
                    height: self.texture_size[1]
                    halign: 'left'
                    text_size: self.width, None

            ScrollView:
                do_scroll_x: False
                do_scroll_y: True

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: app.app_config.SPACING_LARGE # Espacement entre les sections
                    padding: [0,0,0,dp(20)] # Ajouté un padding en bas pour le scrollview

                    # Section des Indicateurs Clés (KPIs)
                    Label:
                        text: "Indicateurs Clés"
                        font_size: app.app_config.FONT_SIZE_LG
                        color: app.app_config.COLOR_PRIMARY
                        size_hint_y: None
                        height: self.texture_size[1] + app.app_config.SPACING_MEDIUM
                        halign: 'left'
                        text_size: self.width, None

                    GridLayout:
                        cols: 2 # Deux colonnes pour les cartes
                        spacing: app.app_config.SPACING_MEDIUM
                        size_hint_y: None
                        height: self.minimum_height

                        DashboardStatCard:
                            title: "Livraisons Actives"
                            value: root.active_deliveries_count
                            icon_source: 'assets/delivery_icon.png' # Assurez-vous d'avoir cette icône
                            card_border_color: app.app_config.COLOR_INFO # Bleu pour info/actives

                        DashboardStatCard:
                            title: "Livraisons en Attente"
                            value: root.pending_deliveries_count
                            icon_source: 'assets/pending_icon.png' # Assurez-vous d'avoir cette icône
                            card_border_color: app.app_config.COLOR_WARNING # Orange pour avertissement/attente

                        DashboardStatCard:
                            title: "Véhicules Disponibles"
                            value: root.vehicles_available_count
                            icon_source: 'assets/vehicle_icon.png' # Assurez-vous d'avoir cette icône
                            card_border_color: app.app_config.COLOR_SUCCESS # Vert pour succès/disponible

                        DashboardStatCard:
                            title: "Chauffeurs en Service"
                            value: root.drivers_on_duty_count
                            icon_source: 'assets/driver_icon.png' # Assurez-vous d'avoir cette icône
                            card_border_color: app.app_config.COLOR_PRIMARY # Bleu primaire

                    # Section des Activités Récentes
                    Label:
                        text: "Activités Récentes"
                        font_size: app.app_config.FONT_SIZE_LG
                        color: app.app_config.COLOR_PRIMARY
                        size_hint_y: None
                        height: self.texture_size[1] + app.app_config.SPACING_MEDIUM
                        halign: 'left'
                        text_size: self.width, None

                    # Conteneur pour les activités récentes (les labels seront ajoutés ici par Python)
                    BoxLayout:
                        id: recent_activities_container
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: app.app_config.SPACING_SMALL
                        padding: app.app_config.PADDING_SMALL
                        canvas.before:
                            Color:
                                rgba: app.app_config.COLOR_BACKGROUND_CARD # Fond blanc pour la liste
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [app.app_config.CORNER_RADIUS_MD] * 4
