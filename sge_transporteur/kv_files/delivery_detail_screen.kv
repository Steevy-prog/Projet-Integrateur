# sge_transporteur/kv_files/delivery_detail_screen.kv

<DeliveryDetailScreen>:
    name: 'delivery_details' # Nom de l'écran, doit correspondre à main.py
    
    BoxLayout:
        orientation: 'vertical'
        padding: app.app_config.PADDING_MEDIUM
        spacing: app.app_config.SPACING_MEDIUM
        
        # En-tête avec bouton retour et titre
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(60) # Hauteur de la barre d'en-tête
            padding: app.app_config.PADDING_SMALL
            spacing: app.app_config.SPACING_SMALL
            canvas.before:
                Color:
                    rgba: app.app_config.COLOR_PRIMARY # Couleur de fond de l'en-tête
                Rectangle:
                    pos: self.pos
                    size: self.size
            
            Button:
                size_hint_x: None
                width: dp(50) # Largeur du bouton icône
                background_normal: '' # Rend le fond du bouton transparent par défaut
                background_color: [0,0,0,0] # Rendre le fond transparent
                on_release: root.go_back() # Appel de la fonction de retour
                Image: # Icône de la flèche de retour
                    source: 'assets/back_arrow.png' # Vous devrez placer cette image dans votre dossier assets
                    size: dp(30), dp(30)
                    pos: self.parent.x + (self.parent.width - self.width)/2, self.parent.y + (self.parent.height - self.height)/2
                    color: app.app_config.COLOR_TEXT_LIGHT # Couleur de l'icône (blanc)
            
            Label:
                text: "Détails de Livraison"
                font_size: app.app_config.FONT_SIZE_XL
                color: app.app_config.COLOR_TEXT_LIGHT
                halign: 'left'
                valign: 'middle'
                text_size: self.width, None
                size_hint_x: 1 # Prend l'espace restant
        
        # Contenu principal de l'écran de détails
        ScrollView:
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height # Le BoxLayout s'adapte à la hauteur de son contenu
                padding: app.app_config.PADDING_LARGE
                spacing: app.app_config.SPACING_MEDIUM
                canvas.before:
                    Color:
                        rgba: app.app_config.COLOR_BACKGROUND_DARK
                    Rectangle:
                        pos: self.pos
                        size: self.size

                # Message de statut général de l'écran de détails
                Label:
                    id: detail_status_label
                    text: root.detail_status_message
                    font_size: app.app_config.FONT_SIZE_SM
                    color: root.detail_status_color
                    size_hint_y: None
                    height: self.texture_size[1]
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.width, None

                # Section des Détails
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: app.app_config.PADDING_SMALL
                    spacing: app.app_config.SPACING_XS
                    canvas.before:
                        Color:
                            rgba: app.app_config.COLOR_BACKGROUND_CARD
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [app.app_config.CORNER_RADIUS_SM] * 4
                        Color:
                            rgba: app.app_config.COLOR_CARD_BORDER_DARK
                        Line:
                            rectangle: self.x, self.y, self.width, self.height
                            width: 1

                    Label:
                        text: f"[b]ID Livraison:[/b] {root.delivery_id}"
                        font_size: app.app_config.FONT_SIZE_MD
                        color: app.app_config.COLOR_TEXT_DARK
                        halign: 'left'
                        valign: 'top'
                        text_size: self.width, None
                        size_hint_y: None
                        height: self.texture_size[1]
                        markup: True

                    Label:
                        text: f"[b]Client:[/b] {root.client_name}"
                        font_size: app.app_config.FONT_SIZE_MD
                        color: app.app_config.COLOR_TEXT_DARK
                        halign: 'left'
                        valign: 'top'
                        text_size: self.width, None
                        size_hint_y: None
                        height: self.texture_size[1]
                        markup: True

                    Label:
                        text: f"[b]Destination:[/b] {root.destination_address}"
                        font_size: app.app_config.FONT_SIZE_MD
                        color: app.app_config.COLOR_TEXT_DARK
                        halign: 'left'
                        valign: 'top'
                        text_size: self.width, None
                        size_hint_y: None
                        height: self.texture_size[1]
                        markup: True

                    Label:
                        text: f"[b]Statut Actuel:[/b] [color={app.app_config.rgba_to_hex(root.detail_status_color)}]{root.current_status}[/color]"
                        font_size: app.app_config.FONT_SIZE_LG
                        bold: True
                        color: app.app_config.COLOR_TEXT_DARK
                        halign: 'left'
                        valign: 'top'
                        text_size: self.width, None
                        size_hint_y: None
                        height: self.texture_size[1]
                        markup: True

                    Label:
                        text: f"[b]Chauffeur Assigné:[/b] {root.driver_assigned}"
                        font_size: app.app_config.FONT_SIZE_MD
                        color: app.app_config.COLOR_TEXT_DARK
                        halign: 'left'
                        valign: 'top'
                        text_size: self.width, None
                        size_hint_y: None
                        height: self.texture_size[1]
                        markup: True

                    Label:
                        text: f"[b]Véhicule Assigné:[/b] {root.vehicle_assigned}"
                        font_size: app.app_config.FONT_SIZE_MD
                        color: app.app_config.COLOR_TEXT_DARK
                        halign: 'left'
                        valign: 'top'
                        text_size: self.width, None
                        size_hint_y: None
                        height: self.texture_size[1]
                        markup: True

                    Label:
                        text: f"[b]Contact Client:[/b] {root.contact_info}"
                        font_size: app.app_config.FONT_SIZE_MD
                        color: app.app_config.COLOR_TEXT_DARK
                        halign: 'left'
                        valign: 'top'
                        text_size: self.width, None
                        size_hint_y: None
                        height: self.texture_size[1]
                        markup: True

                    Label:
                        text: f"[b]Description Articles:[/b] {root.items_description}"
                        font_size: app.app_config.FONT_SIZE_MD
                        color: app.app_config.COLOR_TEXT_DARK
                        halign: 'left'
                        valign: 'top'
                        text_size: self.width, None
                        size_hint_y: None
                        height: self.texture_size[1]
                        markup: True

                # Section des Actions
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: app.app_config.PADDING_SMALL
                    spacing: app.app_config.SPACING_SMALL

                    Label:
                        text: "Actions sur la Livraison"
                        font_size: app.app_config.FONT_SIZE_LG
                        color: app.app_config.COLOR_TEXT_LIGHT
                        halign: 'left'
                        text_size: self.width, None
                        size_hint_y: None
                        height: self.texture_size[1] + app.app_config.SPACING_XS

                    # Conteneur pour les boutons de statut (flux séquentiel)
                    BoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(60)
                        spacing: app.app_config.SPACING_SMALL

                        Button:
                            text: "Chargé"
                            font_size: app.app_config.FONT_SIZE_MD
                            background_normal: ''
                            background_color: app.app_config.COLOR_PRIMARY
                            color: app.app_config.COLOR_TEXT_LIGHT
                            on_release: root.update_delivery_status_action("Chargé")
                            disabled: not root.can_load # Active si can_load est True
                            opacity: 1 if not self.disabled else 0.5 # Rendu visuel de l'état désactivé
                            canvas.before:
                                Color:
                                    rgba: self.background_color
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [app.app_config.CORNER_RADIUS_SM] * 4

                        Button:
                            text: "Parti"
                            font_size: app.app_config.FONT_SIZE_MD
                            background_normal: ''
                            background_color: app.app_config.COLOR_PRIMARY
                            color: app.app_config.COLOR_TEXT_LIGHT
                            on_release: root.update_delivery_status_action("En Transit")
                            disabled: not root.can_depart # Active si can_depart est True
                            opacity: 1 if not self.disabled else 0.5
                            canvas.before:
                                Color:
                                    rgba: self.background_color
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [app.app_config.CORNER_RADIUS_SM] * 4

                        Button:
                            text: "Arrivé"
                            font_size: app.app_config.FONT_SIZE_MD
                            background_normal: ''
                            background_color: app.app_config.COLOR_PRIMARY
                            color: app.app_config.COLOR_TEXT_LIGHT
                            on_release: root.update_delivery_status_action("Arrivé")
                            disabled: not root.can_arrive # Active si can_arrive est True
                            opacity: 1 if not self.disabled else 0.5
                            canvas.before:
                                Color:
                                    rgba: self.background_color
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [app.app_config.CORNER_RADIUS_SM] * 4

                        Button:
                            text: "Livré"
                            font_size: app.app_config.FONT_SIZE_MD
                            background_normal: ''
                            background_color: app.app_config.COLOR_SUCCESS # Vert pour la livraison finale
                            color: app.app_config.COLOR_TEXT_LIGHT
                            on_release: root.update_delivery_status_action("Livré")
                            disabled: not root.can_deliver # Active si can_deliver est True
                            opacity: 1 if not self.disabled else 0.5
                            canvas.before:
                                Color:
                                    rgba: self.background_color
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [app.app_config.CORNER_RADIUS_SM] * 4

                    # Bouton "Signaler un Incident" au centre
                    BoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(60)
                        padding: 0, app.app_config.SPACING_MEDIUM, 0, 0 # Espacement au-dessus

                        Widget: # Espaceur gauche pour centrer le bouton
                            size_hint_x: 1
                        
                        Button:
                            text: "Signaler un Incident"
                            font_size: app.app_config.FONT_SIZE_MD
                            background_normal: ''
                            background_color: app.app_config.COLOR_ERROR # Rouge pour les incidents
                            color: app.app_config.COLOR_TEXT_LIGHT
                            size_hint_x: 0.7 # Prend plus de place pour être plus visible au centre
                            on_release: print("Action: Signaler un Incident") # Action à implémenter plus tard
                            canvas.before:
                                Color:
                                    rgba: self.background_color
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [app.app_config.CORNER_RADIUS_SM] * 4
                        
                        Widget: # Espaceur droit
                            size_hint_x: 1

                # Section Historique des Statuts (mise à jour pour la suppression)
                Label:
                    text: "Historique des Statuts"
                    font_size: app.app_config.FONT_SIZE_LG
                    bold: True
                    color: app.app_config.COLOR_PRIMARY
                    halign: 'left'
                    text_size: self.width, None
                    size_hint_y: None
                    height: self.texture_size[1] + app.app_config.SPACING_SMALL
                    markup: True
                
                # Le conteneur pour les éléments d'historique (maintenant des HistoryStatusItem)
                BoxLayout:
                    id: status_history_container
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: app.app_config.SPACING_XS
                    padding: app.app_config.PADDING_SMALL
                    canvas.before:
                        Color:
                            rgba: app.app_config.COLOR_BACKGROUND_CARD
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [app.app_config.CORNER_RADIUS_SM] * 4
                        Color:
                            rgba: app.app_config.COLOR_CARD_BORDER_DARK
                        Line:
                            rectangle: self.x, self.y, self.width, self.height
                            width: 1

# Nouvelle définition pour un élément d'historique de statut (pour permettre la suppression)
# La classe Python correspondante est HistoryStatusItem dans delivery_detail_screen.py
<HistoryStatusItem>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(30)
    spacing: dp(10)
    padding: dp(5)

    Label:
        id: status_label
        text: root.status_text # Texte du statut (ex: Chargé à 2025-06-26 15:30)
        markup: True
        font_size: app.app_config.FONT_SIZE_SM
        color: root.item_color # Couleur dynamique basée sur le statut
        halign: 'left'
        valign: 'middle'
        text_size: self.width, None
        size_hint_x: 0.9

    Button:
        id: delete_button
        size_hint_x: None
        width: dp(25) # Petite largeur pour le bouton poubelle
        background_normal: ''
        background_color: [0,0,0,0] # Bouton transparent
        on_release: app.root.get_screen('delivery_details').show_delete_history_popup(root.history_data_item) # Passe l'élément de données complet
        Image: # Icône de la poubelle
            source: 'assets/trash_icon.png' # Vous devrez placer cette image dans votre dossier assets
            size: dp(20), dp(20)
            pos: self.parent.x + (self.parent.width - self.width)/2, self.parent.y + (self.parent.height - self.height)/2
            color: app.app_config.COLOR_ERROR # Couleur de la poubelle (rouge)
